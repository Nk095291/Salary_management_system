DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Railway volume (production): mount /data and set:
# DJANGO_DB_PATH=/data/db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (must match frontend URL when DJANGO_DEBUG=False):
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app

# Email (create_hr sends credentials; console backend in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
# Production SMTP (uncomment and set):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

FRONTEND_LOGIN_URL=http://localhost:5173/login
